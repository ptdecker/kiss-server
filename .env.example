# EC2 SSH access — used by `just logs` and `just logs-follow`
# Copy this file to .env and fill in your values.
# .env is gitignored; never commit it with a real IP address.

# Required: EC2 username and IP (or elastic IP / hostname)
EC2_HOST=<user>@<host-or-ip>

# Optional: path to SSH private key. Omit to use the SSH agent.
# Use $HOME, not ~ (tilde is not expanded inside double quotes in all shells).
# EC2_SSH_KEY=$HOME/.ssh/id_ed25519
